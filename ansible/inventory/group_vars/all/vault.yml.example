---
# This is an EXAMPLE vault file
# DO NOT commit the actual vault.yml with real secrets
#
# To create your encrypted vault.yml:
# 1. Copy this file: cp vault.yml.example vault.yml
# 2. Edit vault.yml and add your real Cloudflare API token
# 3. Encrypt it: ansible-vault encrypt vault.yml
# 4. The encrypted vault.yml CAN be committed to git safely

# Cloudflare API token for DNS-01 ACME challenge
# Get this from: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:DNS:Edit for the specific zone
vault_cloudflare_api_token: "your-cloudflare-api-token-here"

# iDRAC root password for R730xd remote management
# Used by r730xd-storage.yml to resolve drive bays at runtime
vault_idrac_password: "your-idrac-password-here"

# Foundation data stores (R730xd)
vault_postgres_password: "your-postgres-superuser-password-here"
vault_kv_cache_password: "your-kv-cache-password-here"

# versitygw stores (ADR-055) — NOT set here. The s3-hot/s3-bulk root creds
# live in 1Password and are read back via ansible/vars/onepassword_secrets.yml
# as vault_s3_{hot,bulk}_root_access_key / vault_s3_{hot,bulk}_root_secret_key.

# Observability stack (R730xd)
vault_grafana_admin_password: "your-grafana-admin-password-here"
vault_obs_s3_access_key: "your-obs-s3-access-key-here"
vault_obs_s3_secret_key: "your-obs-s3-secret-key-here"

# WiFi PSKs for the Aerohive APs (AP630 + AP130). Rendered into the committed
# HiveOS scripts (ansible/files/aerohive/) at paste time, per
# docs/runbooks/aerohive-ap-setup.md. WPA2-AES-PSK — 8..63 ASCII chars.
# `home` = the existing SSID (restricted, VLAN 20); `trusted` = the new trusted
# SSID (VLAN 30). Use distinct PSKs.
vault_home_wifi_psk: "your-home-wifi-psk-here"
vault_trusted_wifi_psk: "your-trusted-wifi-psk-here"


# 1Password service account tokens — the platform's secret path. Every
# platform secret lives in the `grizzly-platform` 1Password vault and is
# reached with one of these. `ansible-reader` backs the lookups in
# ansible/vars/onepassword_secrets.yml; `eso-reader` is written into the
# cluster by setup-1password-eso.yml for External Secrets; `operator` is the
# only one holding write_items, used for adding and rotating secrets by hand.
#
# These are the ONLY secrets the IaC layer needs. .vault_pass gates them, and
# a service account token cannot be read back out of 1Password once minted —
# so if .vault_pass is lost, every token must be re-minted by hand. See
# docs/runbooks/onepassword-quickref.md for minting and rotation.
vault_op_service_account_token: "ops_your-ansible-reader-token"
vault_op_eso_service_account_token: "ops_your-eso-reader-token"
vault_op_operator_service_account_token: "ops_your-operator-token"
