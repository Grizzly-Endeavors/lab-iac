#!/usr/bin/env bash
# Managed by Ansible — r730xd-postgres role
# Daily pg_dumpall backup with rotation
set -euo pipefail

BACKUP_DIR="{{ postgres_backup_dir }}"
RETENTION_DAYS="{{ postgres_backup_retention_days }}"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP_FILE="${BACKUP_DIR}/pg_dumpall-${TIMESTAMP}.sql.gz"
MIN_SIZE_BYTES=1048576 # 1MB floor

# Dump all databases
docker exec foundation-postgres pg_dumpall -U postgres | gzip > "${BACKUP_FILE}"

# 1. Basic existence and size check
if [ ! -s "${BACKUP_FILE}" ]; then
    echo "ERROR: Backup file is empty: ${BACKUP_FILE}" >&2
    rm -f "${BACKUP_FILE}"
    exit 1
fi

FILE_SIZE=$(stat -c %s "${BACKUP_FILE}")
if (( FILE_SIZE < MIN_SIZE_BYTES )); then
    echo "ERROR: Backup size ${FILE_SIZE}B is below floor ${MIN_SIZE_BYTES}B: ${BACKUP_FILE}" >&2
    rm -f "${BACKUP_FILE}"
    exit 1
fi

# 2. Integrity check (gzip test)
if ! gzip -t "${BACKUP_FILE}"; then
    echo "ERROR: Gzip integrity check failed: ${BACKUP_FILE}" >&2
    rm -f "${BACKUP_FILE}"
    exit 1
fi

# 3. Content check (verify it contains actual database definitions)
if ! zgrep -E "CREATE DATABASE|CREATE ROLE" "${BACKUP_FILE}" >/dev/null 2>&1; then
    echo "ERROR: Backup contains no database/role definitions: ${BACKUP_FILE}" >&2
    rm -f "${BACKUP_FILE}"
    exit 1
fi

# Rotate old backups only after successful verification
find "${BACKUP_DIR}" -name "pg_dumpall-*.sql.gz" -mtime "+${RETENTION_DAYS}" -delete

echo "Backup complete: ${BACKUP_FILE} (${FILE_SIZE} bytes)"
