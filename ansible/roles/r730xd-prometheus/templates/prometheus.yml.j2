# Managed by Ansible — r730xd-prometheus role
# Prometheus scrape configuration for the grizzly-platform observability stack

global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}

rule_files:
  - "rules/*.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            # Compose service name — Prometheus and Alertmanager run as
            # separate containers on the bridge network, so "localhost" inside
            # this container is NOT Alertmanager. The internal listen port is
            # always 9093 regardless of the published host port.
            - "alertmanager:9093"

scrape_configs:
  - job_name: "node"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/nodes.yml"
          - "/etc/prometheus/targets.d/node-*.yml"
        refresh_interval: 30s

  - job_name: "ipmi"
    scrape_interval: 30s
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/ipmi.yml"
          - "/etc/prometheus/targets.d/ipmi-*.yml"
        refresh_interval: 30s

{% for svc in prometheus_observability_targets %}
  - job_name: "{{ svc.job }}"
{% if svc.metrics_path is defined %}
    metrics_path: "{{ svc.metrics_path }}"
{% endif %}
    static_configs:
      - targets:
          - "{{ svc.target }}"
        labels:
          env: "grizzly-platform"
{% if svc.metric_relabel is defined %}
    metric_relabel_configs:
{% for rule in svc.metric_relabel %}
      - source_labels: [{{ rule.source_labels | join(', ') }}]
        regex: '{{ rule.regex }}'
        target_label: {{ rule.target_label }}
        replacement: '{{ rule.replacement }}'
{% endfor %}
{% endif %}

{% endfor %}
  - job_name: "etcd"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-etcd.yml"
        refresh_interval: 30s

  # OpenBao internal telemetry. Scrapes /v1/sys/metrics?format=prometheus,
  # which requires a token (prometheus-readonly policy → read sys/metrics).
  # The OpenBao Agent (r730xd-openbao-agent role) auto-authenticates via
  # AppRole and writes a short-TTL token to a file sink, bind-mounted here
  # as /etc/prometheus/openbao/token. `up{job="openbao"} == 0` now means the
  # server is down/sealed OR the agent token is missing — see
  # docs/runbooks/openbao-quickref.md and issue #41.
  - job_name: "openbao"
    scheme: https
    metrics_path: /v1/sys/metrics
    params:
      format: ["prometheus"]
    authorization:
      credentials_file: /etc/prometheus/openbao/token
    tls_config:
      # Self-signed CA from the r730xd-openbao role. The Prometheus
      # container doesn't have the host CA bundle; skipping verify is
      # acceptable because the target is the same host (r730xd→r730xd).
      insecure_skip_verify: true
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/openbao.yml"
        refresh_interval: 30s

{% if prometheus_k8s_apiserver_target is defined and prometheus_k8s_apiserver_target %}
  - job_name: "kube-apiserver"
    scheme: https
    tls_config:
      ca_file: /etc/prometheus/k8s-auth/ca.crt
      insecure_skip_verify: false
    authorization:
      credentials_file: /etc/prometheus/k8s-auth/token
    static_configs:
      - targets:
          - "{{ prometheus_k8s_apiserver_target }}"
        labels:
          env: "grizzly-platform"
          component: "kube-apiserver"
{% endif %}

  - job_name: "kubelet"
    scheme: https
    tls_config:
      ca_file: /etc/prometheus/k8s-auth/ca.crt
      # kubelet self-signed certs use hostnames, not IPs — skip server cert verification
      # Authentication is still enforced via bearer token + webhook authz
      insecure_skip_verify: true
    authorization:
      credentials_file: /etc/prometheus/k8s-auth/token
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-kubelet.yml"
        refresh_interval: 30s

  - job_name: "cilium-agent"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-cilium-agent.yml"
        refresh_interval: 30s

  # Cilium operator is a single-replica, hostNetwork Deployment that floats
  # across nodes, so a static file_sd target can't track it. Discover the pod
  # via the kube API and scrape it on its node IP:9963. Uses the
  # prometheus-metrics SA token (needs pods list/watch — granted in
  # setup-k8s-cluster-metrics.yml).
  - job_name: "cilium-operator"
    kubernetes_sd_configs:
      - role: pod
        api_server: "https://{{ hostvars[groups['k8s_control_plane'][0]]['ansible_host'] }}:6443"
        tls_config:
          ca_file: /etc/prometheus/k8s-auth/ca.crt
        authorization:
          credentials_file: /etc/prometheus/k8s-auth/token
        namespaces:
          names:
            - kube-system
    relabel_configs:
      - source_labels: [__meta_kubernetes_pod_label_io_cilium_app]
        regex: operator
        action: keep
      - source_labels: [__meta_kubernetes_pod_ip]
        regex: (.+)
        target_label: __address__
        replacement: "${1}:9963"
      - source_labels: [__meta_kubernetes_pod_node_name]
        target_label: instance
      - target_label: env
        replacement: "grizzly-platform"
      - target_label: component
        replacement: "cilium-operator"

  - job_name: "hubble"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-hubble.yml"
        refresh_interval: 30s

  - job_name: "kube-state-metrics"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-kube-state-metrics.yml"
        refresh_interval: 30s

  - job_name: "flux-system"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-flux.yml"
        refresh_interval: 30s

  - job_name: "arc-controller"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-arc.yml"
        refresh_interval: 30s

  - job_name: "argo-workflows"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-argo.yml"
        refresh_interval: 30s

  - job_name: "gitlab-runner"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-gitlab-runner.yml"
        refresh_interval: 30s

  # zot OCI registry metrics (Prometheus extension on the registry HTTP port,
  # reached via the registry NodePort; default /metrics path).
  - job_name: "registry-zot"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-zot.yml"
        refresh_interval: 30s

  # Kyverno admission controller — the CI gate's deploy boundary. With
  # failurePolicy:Fail, Kyverno being down blocks pod admission in gated
  # namespaces, so this scrape feeds the KyvernoDown alert.
  - job_name: "kyverno"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-kyverno.yml"
        refresh_interval: 30s

  - job_name: "ingress-nginx"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-ingress-nginx.yml"
        refresh_interval: 30s

  - job_name: "cert-manager"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-cert-manager.yml"
        refresh_interval: 30s

  # External Secrets Operator — materialises every platform secret in the
  # cluster from 1Password. ExternalSecrets sync on change rather than on a
  # timer, so a broken reference or a dead service account token produces no
  # runtime symptom at all; these metrics are the only signal that the secrets
  # plane has stopped working.
  - job_name: "external-secrets"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-external-secrets.yml"
        refresh_interval: 30s

  # authentik — central identity provider. SSO/OIDC for every app wired to it,
  # so an outage cascades to those logins; this scrape feeds the AuthentikDown
  # alert. Metrics on the server :9300 port, published via NodePort 30891.
  - job_name: "authentik"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-authentik.yml"
        refresh_interval: 30s

  # grizzly-invite — invitation broker on the Authentik enrollment path. If it's
  # down, NEW sign-ups fail (existing logins are unaffected); this scrape feeds
  # the InviteBrokerDown alert. Metrics on the http :8080 port, NodePort 30892.
  - job_name: "grizzly-invite"
    file_sd_configs:
      - files:
          - "/etc/prometheus/targets.d/k8s-grizzly-invite.yml"
        refresh_interval: 30s

{% if prometheus_blackbox_targets is defined and prometheus_blackbox_targets | length > 0 %}
  - job_name: "blackbox"
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
{% for target in prometheus_blackbox_targets %}
          - "{{ target }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: env
        replacement: "grizzly-platform"
      - target_label: __address__
        replacement: "{{ prometheus_blackbox_exporter }}"
{% endif %}
